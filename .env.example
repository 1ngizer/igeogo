# ===========================================
# igeogo - Variables de entorno (ejemplo)
# Copia este archivo como ".env" y rellena los valores reales.
# NUNCA subas el archivo .env real al repositorio.
# ===========================================

# --- Servidor ---
PORT=3000
NODE_ENV=development

# --- Base de datos (MongoDB) ---
# Local: mongodb://127.0.0.1:27017/igeogo
# Atlas: mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/igeogo
MONGODB_URI=mongodb://127.0.0.1:27017/igeogo

# --- WhatsApp Cloud API (Meta) ---
# Token de verificación que TÚ inventas. Debe coincidir con el que pongas
# en el panel de Meta al configurar el webhook.
WHATSAPP_VERIFY_TOKEN=igeogo_verify_token_cambiame

# Token de acceso de la app de Meta (System User / temporal de pruebas).
WHATSAPP_ACCESS_TOKEN=

# ID del número de teléfono (Phone Number ID) de la WhatsApp Cloud API.
WHATSAPP_PHONE_NUMBER_ID=

# Versión de la Graph API a usar.
WHATSAPP_API_VERSION=v21.0

# --- Lógica de negocio ---
# Radio de búsqueda de cupones en metros (2 km por defecto).
SEARCH_RADIUS_METERS=2000

# Clave simple para proteger los endpoints de administración (cabecera x-admin-key).
ADMIN_API_KEY=cambiame_admin_key

# --- Google Analytics 4 (landing pages) ---
# Solo informativo: las landing pages son estáticas (public/landing/), el
# Measurement ID va hardcodeado directamente en el <head> de cada HTML
# (no es un secreto, es público en el código fuente de cualquier sitio con GA).
# Cuenta: ingizer · Propiedad: igeogo
GA_MEASUREMENT_ID=G-9Q6DNKDM7S

# --- Notion (tablero del ecosistema, ver sync.js) ---
# Integration token: notion.so/my-integrations → tu integración → "Internal Integration Secret"
NOTION_TOKEN=

# ID de la base de datos de Notion donde vive el tablero de proyectos.
# Se saca de la URL de la base de datos: notion.so/<workspace>/<DATABASE_ID>?v=...
# La base debe tener compartida la integración ("..." → Connections → tu integración).
NOTION_DATABASE_ID=
