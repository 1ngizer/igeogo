# ===========================================
# igeogo - Variables de entorno (ejemplo)
# Copia este archivo como ".env" y rellena los valores reales.
# NUNCA subas el archivo .env real al repositorio.
# ===========================================

# --- Servidor ---
PORT=3000
NODE_ENV=development

# --- Base de datos (MongoDB) ---
# Local: mongodb://127.0.0.1:27017/igeogo
# Atlas: mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/igeogo
MONGODB_URI=mongodb://127.0.0.1:27017/igeogo

# --- WhatsApp Cloud API (Meta) ---
# Token de verificación que TÚ inventas. Debe coincidir con el que pongas
# en el panel de Meta al configurar el webhook.
WHATSAPP_VERIFY_TOKEN=igeogo_verify_token_cambiame

# Token de acceso de la app de Meta (System User / temporal de pruebas).
WHATSAPP_ACCESS_TOKEN=

# ID del número de teléfono (Phone Number ID) de la WhatsApp Cloud API.
WHATSAPP_PHONE_NUMBER_ID=

# Versión de la Graph API a usar.
WHATSAPP_API_VERSION=v21.0

# App Secret de la app de Meta (developers.facebook.com → Configuración → Básica).
# OBLIGATORIO en producción: firma de los webhooks. Sin él, el webhook rechaza todo.
WHATSAPP_APP_SECRET=

# Plantilla de marketing aprobada EN LA MISMA cuenta de WhatsApp (WABA) del número.
# El idioma debe coincidir exacto con el de la plantilla (Spanish (COL) = es_CO, Spanish = es).
WHATSAPP_TEMPLATE_NAME=oferta_cercana
WHATSAPP_TEMPLATE_LANG=es_CO

# --- Seguridad ---
# OBLIGATORIO en producción (la app no arranca sin él): openssl rand -hex 32
# Solo se omite con NODE_ENV=development o test.
APP_SECRET=

# --- IA (opcional) ---
# Llave de la API de Anthropic (una por proyecto; la de igeogo se llama igeogo-railway en el Console).
ANTHROPIC_API_KEY=
# Modelo de Claude para copy, moderación e insights.
ANTHROPIC_MODEL=claude-haiku-4-5

# --- Pagos (Wompi) ---
# sandbox para pruebas, production para cobros reales (el comercio de producción lo comparte igeogo con otros proyectos).
WOMPI_ENV=sandbox
# Llave privada del comercio (prv_test_... o prv_prod_...). Nunca la subas al repositorio.
WOMPI_PRIVATE_KEY=
# Secreto de eventos: valida la firma de los avisos de pago que Wompi envía al servidor.
WOMPI_EVENTS_SECRET=

# --- Lógica de negocio ---
# Radio de búsqueda de cupones en metros (2 km por defecto).
SEARCH_RADIUS_METERS=2000

# Clave simple para proteger los endpoints de administración (cabecera x-admin-key).
ADMIN_API_KEY=cambiame_admin_key

# --- Google Analytics 4 (landing pages) ---
# Solo informativo: las landing pages son estáticas (public/landing/), el
# Measurement ID va hardcodeado directamente en el <head> de cada HTML
# (no es un secreto, es público en el código fuente de cualquier sitio con GA).
# Cuenta: ingizer · Propiedad: igeogo
GA_MEASUREMENT_ID=G-9Q6DNKDM7S
